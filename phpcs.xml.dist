<?xml version="1.0"?>
<ruleset name="Siteation_DebugBar">
    <description>Magento2 coding standard, minus the sniffs that demand redundant annotations.</description>

    <file>.</file>
    <exclude-pattern>*/src-js/*</exclude-pattern>
    <exclude-pattern>*/view/base/web/*</exclude-pattern>

    <arg name="extensions" value="php,xml"/>
    <arg name="colors"/>
    <arg value="sp"/>

    <rule ref="Magento2">
        <!--
            These require a docblock on every method and a @param for every argument.
            The code is fully typed, so those blocks would only restate the signature.
            Docblocks are still used where they carry something the types cannot, such as
            array shapes and the reason a decision was made.
        -->
        <exclude name="Magento2.Annotation.MethodAnnotationStructure"/>
        <exclude name="Magento2.Annotation.MethodArguments"/>
        <exclude name="Magento2.Commenting.ClassPropertyPHPDocFormatting"/>
    </rule>
</ruleset>
