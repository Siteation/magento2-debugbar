<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="dev">
            <group id="siteation_debugbar" translate="label" type="text" sortOrder="900"
                   showInDefault="1" showInWebsite="0" showInStore="0">
                <label>Siteation Debug Bar</label>
                <field id="enabled" translate="label comment" type="select" sortOrder="10"
                       showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Production mode disables the bar regardless of this setting.</comment>
                </field>
                <field id="areas" translate="label comment" type="multiselect" sortOrder="15"
                       showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Active In</label>
                    <source_model>Siteation\DebugBar\Model\Config\Source\Areas</source_model>
                    <comment>Which areas produce a profile. Select none to cover all of them.</comment>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="slow_query_ms" translate="label comment" type="text" sortOrder="20"
                       showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Slow Query Threshold (ms)</label>
                    <validate>validate-number validate-greater-than-zero</validate>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="slow_request_ms" translate="label comment" type="text" sortOrder="30"
                       showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Slow Request Threshold (ms)</label>
                    <validate>validate-number validate-greater-than-zero</validate>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="allowed_ips" translate="label comment" type="text" sortOrder="40"
                       showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Allowed IP Addresses</label>
                    <comment>Comma separated. Leave empty to allow every address.</comment>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="value_policy" translate="label comment" type="select" sortOrder="50"
                       showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Captured Values</label>
                    <source_model>Siteation\DebugBar\Model\Config\Source\ValuePolicy</source_model>
                    <comment><![CDATA[Query bindings are positional, so a value a customer typed cannot be recognised by name. Full keeps them, which is what makes SQL readable. Mask or drop them if this instance is shared.]]></comment>
                    <depends><field id="enabled">1</field></depends>
                </field>
            </group>
        </section>
    </system>
</config>
