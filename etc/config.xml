<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <dev>
            <siteation_debugbar>
                <!--
                    Off until asked for. The bar stores SQL, bindings, cache keys and
                    request data, so installing the module must not start collecting it.
                    Outside developer mode this flag is not enough on its own: an access
                    key is required as well, so "on" can never mean on for every customer.
                -->
                <enabled>0</enabled>
                <areas>frontend,adminhtml,graphql,webapi_rest</areas>
                <slow_query_ms>100</slow_query_ms>
                <slow_request_ms>1000</slow_request_ms>
                <allowed_ips/>
                <value_policy>full</value_policy>
                <!--
                    Empty is the developer machine, where there is nobody to keep out.
                    Production refuses to enable without one, because a store switch would
                    mean on for every customer rather than on for you.
                -->
                <access_key/>
                <!-- Off until an editor is named: a link to a scheme nothing handles is worse than text. -->
                <editor/>
                <editor_template/>
                <editor_path_map/>
            </siteation_debugbar>
        </dev>
    </default>
</config>
