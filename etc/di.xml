<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <!--
        Brackets every web request in every area: frontend, adminhtml, GraphQL and REST.
        Must be an around plugin: launch() switches the object manager to the request's
        area, and an after listener does not survive that reload. See docs/developer-guide.md.
    -->
    <type name="Magento\Framework\App\Http">
        <plugin name="siteation_debugbar_http"
                type="Siteation\DebugBar\Plugin\App\HttpPlugin"
                sortOrder="1"/>
    </type>

    <!--
        Everything the plugin only touches after the gate says yes, behind a proxy.

        Constructing HttpPlugin builds whatever its arguments need, and that happens on
        every request in every area before allows() is consulted. Eagerly that is the whole
        module: ten collectors, twelve rules, the filesystem, and the asset repository with
        the design resolver behind it. The module's posture is that it is safe to leave
        installed because it is off by default, and this is what makes that true.

        RequestEligibility and the logger stay eager: they are what the gate is.
    -->
    <type name="Siteation\DebugBar\Plugin\App\HttpPlugin">
        <arguments>
            <argument name="accessKey" xsi:type="object">Siteation\DebugBar\Model\AccessKey\Proxy</argument>
            <argument name="manager" xsi:type="object">Siteation\DebugBar\Model\ProfileManager\Proxy</argument>
            <argument name="store" xsi:type="object">Siteation\DebugBar\Model\ProfileStore\Proxy</argument>
            <argument name="injector" xsi:type="object">Siteation\DebugBar\Presentation\BarInjector\Proxy</argument>
        </arguments>
    </type>

    <!--
        The same for every other plugin. They are built on every request, wherever the thing they
        wrap is built, and they only ever use the manager and the collectors after asking
        CollectionState, which has no dependencies and is false unless the gate said yes. The
        manager and the collectors are therefore not constructed at all while the bar is off.
    -->
    <type name="Siteation\DebugBar\Plugin\Db\LoggerPlugin">
        <arguments>
            <argument name="manager" xsi:type="object">Siteation\DebugBar\Model\ProfileManager\Proxy</argument>
            <argument name="queries" xsi:type="object">Siteation\DebugBar\Collector\QueryCollector\Proxy</argument>
        </arguments>
    </type>

    <type name="Siteation\DebugBar\Plugin\Event\ManagerPlugin">
        <arguments>
            <argument name="manager" xsi:type="object">Siteation\DebugBar\Model\ProfileManager\Proxy</argument>
            <argument name="events" xsi:type="object">Siteation\DebugBar\Collector\EventCollector\Proxy</argument>
        </arguments>
    </type>

    <type name="Siteation\DebugBar\Plugin\Event\InvokerPlugin">
        <arguments>
            <argument name="manager" xsi:type="object">Siteation\DebugBar\Model\ProfileManager\Proxy</argument>
            <argument name="observers" xsi:type="object">Siteation\DebugBar\Collector\ObserverCollector\Proxy</argument>
            <argument name="events" xsi:type="object">Siteation\DebugBar\Collector\EventCollector\Proxy</argument>
        </arguments>
    </type>

    <type name="Siteation\DebugBar\Plugin\View\BlockPlugin">
        <arguments>
            <argument name="manager" xsi:type="object">Siteation\DebugBar\Model\ProfileManager\Proxy</argument>
            <argument name="blocks" xsi:type="object">Siteation\DebugBar\Collector\BlockCollector\Proxy</argument>
        </arguments>
    </type>

    <type name="Siteation\DebugBar\Plugin\View\LayoutPlugin">
        <arguments>
            <argument name="manager" xsi:type="object">Siteation\DebugBar\Model\ProfileManager\Proxy</argument>
            <argument name="pageCache" xsi:type="object">Siteation\DebugBar\Collector\PageCacheCollector\Proxy</argument>
            <argument name="uncacheable" xsi:type="object">Siteation\DebugBar\Model\UncacheableBlocks\Proxy</argument>
            <argument name="layout" xsi:type="object">Siteation\DebugBar\Collector\LayoutCollector\Proxy</argument>
        </arguments>
    </type>

    <type name="Siteation\DebugBar\Plugin\App\PageCacheKernelPlugin">
        <arguments>
            <argument name="manager" xsi:type="object">Siteation\DebugBar\Model\ProfileManager\Proxy</argument>
            <argument name="pageCache" xsi:type="object">Siteation\DebugBar\Collector\PageCacheCollector\Proxy</argument>
        </arguments>
    </type>

    <type name="Siteation\DebugBar\Plugin\App\CachePlugin">
        <arguments>
            <argument name="manager" xsi:type="object">Siteation\DebugBar\Model\ProfileManager\Proxy</argument>
            <argument name="cache" xsi:type="object">Siteation\DebugBar\Collector\CacheCollector\Proxy</argument>
        </arguments>
    </type>

    <!-- The PDO adapter brackets every query with these two calls -->
    <type name="Magento\Framework\DB\LoggerInterface">
        <plugin name="siteation_debugbar_query"
                type="Siteation\DebugBar\Plugin\Db\LoggerPlugin"
                sortOrder="1"/>
    </type>

    <!-- Every dispatched event, including the ones nobody observes -->
    <type name="Magento\Framework\Event\ManagerInterface">
        <plugin name="siteation_debugbar_event"
                type="Siteation\DebugBar\Plugin\Event\ManagerPlugin"
                sortOrder="1"/>
    </type>

    <!-- Every observer that actually ran, timed individually -->
    <type name="Magento\Framework\Event\InvokerInterface">
        <plugin name="siteation_debugbar_observer"
                type="Siteation\DebugBar\Plugin\Event\InvokerPlugin"
                sortOrder="1"/>
    </type>

    <!-- Times every block render, so slow templates surface without a profiler build -->
    <type name="Magento\Framework\View\Element\AbstractBlock">
        <plugin name="siteation_debugbar_block"
                type="Siteation\DebugBar\Plugin\View\BlockPlugin"
                sortOrder="1"/>
    </type>

    <!-- The built-in full page cache: a hit, and the response it was offered before it rewrote the headers -->
    <type name="Magento\Framework\App\PageCache\Kernel">
        <plugin name="siteation_debugbar_page_cache"
                type="Siteation\DebugBar\Plugin\App\PageCacheKernelPlugin"
                sortOrder="1"/>
    </type>

    <!-- The handles the generated layout loaded, whether it can be cached, and which blocks say it cannot -->
    <type name="Magento\Framework\View\Layout">
        <plugin name="siteation_debugbar_layout"
                type="Siteation\DebugBar\Plugin\View\LayoutPlugin"
                sortOrder="1"/>
    </type>

    <!-- The same file source the layout merge reads, so a handle maps to the files it did -->
    <type name="Siteation\DebugBar\Model\LayoutFiles">
        <arguments>
            <argument name="fileSource" xsi:type="object">Magento\Framework\View\Layout\File\Collector\Aggregated\Proxy</argument>
        </arguments>
    </type>

    <type name="Magento\Framework\App\CacheInterface">
        <plugin name="siteation_debugbar_cache"
                type="Siteation\DebugBar\Plugin\App\CachePlugin"
                sortOrder="1"/>
    </type>

    <type name="Siteation\DebugBar\Model\ProfileManager">
        <arguments>
            <argument name="collectors" xsi:type="array">
                <item name="request" xsi:type="object">Siteation\DebugBar\Collector\RequestCollector</item>
                <item name="queries" xsi:type="object">Siteation\DebugBar\Collector\QueryCollector</item>
                <item name="events" xsi:type="object">Siteation\DebugBar\Collector\EventCollector</item>
                <item name="observers" xsi:type="object">Siteation\DebugBar\Collector\ObserverCollector</item>
                <item name="blocks" xsi:type="object">Siteation\DebugBar\Collector\BlockCollector</item>
                <item name="cache" xsi:type="object">Siteation\DebugBar\Collector\CacheCollector</item>
                <item name="interception" xsi:type="object">Siteation\DebugBar\Collector\InterceptionCollector</item>
                <item name="pagecache" xsi:type="object">Siteation\DebugBar\Collector\PageCacheCollector</item>
                <item name="layout" xsi:type="object">Siteation\DebugBar\Collector\LayoutCollector</item>
                <item name="seo" xsi:type="object">Siteation\DebugBar\Collector\SeoCollector</item>
            </argument>
        </arguments>
    </type>

    <type name="Siteation\DebugBar\Analysis\ProfileAnalyzer">
        <arguments>
            <argument name="rules" xsi:type="array">
                <item name="request_error" xsi:type="object">Siteation\DebugBar\Analysis\Rule\RequestErrorRule</item>
                <item name="request_slow" xsi:type="object">Siteation\DebugBar\Analysis\Rule\SlowRequestRule</item>
                <item name="query_slow" xsi:type="object">Siteation\DebugBar\Analysis\Rule\SlowQueryRule</item>
                <item name="query_repeated" xsi:type="object">Siteation\DebugBar\Analysis\Rule\RepeatedQueryRule</item>
                <item name="block_slow" xsi:type="object">Siteation\DebugBar\Analysis\Rule\SlowBlockRule</item>
                <item name="observer_slow" xsi:type="object">Siteation\DebugBar\Analysis\Rule\SlowObserverRule</item>
                <item name="cache_miss" xsi:type="object">Siteation\DebugBar\Analysis\Rule\CacheMissRule</item>
                <item name="page_not_cached" xsi:type="object">Siteation\DebugBar\Analysis\Rule\PageNotCachedRule</item>
                <item name="seo_canonical" xsi:type="object">Siteation\DebugBar\Analysis\Rule\SeoCanonicalRule</item>
                <item name="seo_noindex" xsi:type="object">Siteation\DebugBar\Analysis\Rule\SeoNoindexRule</item>
                <item name="seo_heading" xsi:type="object">Siteation\DebugBar\Analysis\Rule\SeoHeadingRule</item>
                <item name="seo_schema_offer" xsi:type="object">Siteation\DebugBar\Analysis\Rule\SeoSchemaOfferRule</item>
                <item name="production_mode" xsi:type="object">Siteation\DebugBar\Analysis\Rule\ProductionModeRule</item>
                <item name="collector_truncated" xsi:type="object">Siteation\DebugBar\Analysis\Rule\TruncatedCollectorRule</item>
            </argument>
        </arguments>
    </type>

    <type name="Siteation\DebugBar\Mcp\Server">
        <arguments>
            <argument name="tools" xsi:type="array">
                <item name="list_profiles" xsi:type="object">Siteation\DebugBar\Mcp\Tool\ListProfiles</item>
                <item name="get_findings" xsi:type="object">Siteation\DebugBar\Mcp\Tool\GetFindings</item>
                <item name="get_section" xsi:type="object">Siteation\DebugBar\Mcp\Tool\GetSection</item>
                <item name="inspect_queries" xsi:type="object">Siteation\DebugBar\Mcp\Tool\InspectQueries</item>
                <item name="compare_profiles" xsi:type="object">Siteation\DebugBar\Mcp\Tool\CompareProfiles</item>
                <item name="get_seo" xsi:type="object">Siteation\DebugBar\Mcp\Tool\GetSeo</item>
            </argument>
        </arguments>
    </type>

    <type name="Magento\Framework\Console\CommandListInterface">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="siteation_debugbar_mcp" xsi:type="object">Siteation\DebugBar\Console\McpServerCommand</item>
                <item name="siteation_debugbar_report" xsi:type="object">Siteation\DebugBar\Console\ReportCommand</item>
            </argument>
        </arguments>
    </type>

</config>
