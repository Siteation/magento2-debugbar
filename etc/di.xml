<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <!--
        Brackets every web request in every area: frontend, adminhtml, GraphQL and REST.
        Must be an around plugin: launch() switches the object manager to the request's
        area, and an after listener does not survive that reload. See docs/research.md 13.1.
    -->
    <type name="Magento\Framework\App\Http">
        <plugin name="siteation_debugbar_http"
                type="Siteation\DebugBar\Plugin\App\HttpPlugin"
                sortOrder="1"/>
    </type>

    <!-- The PDO adapter brackets every query with these two calls -->
    <type name="Magento\Framework\DB\LoggerInterface">
        <plugin name="siteation_debugbar_query"
                type="Siteation\DebugBar\Plugin\Db\LoggerPlugin"
                sortOrder="1"/>
    </type>

    <!-- Every dispatched event, including the ones nobody observes -->
    <type name="Magento\Framework\Event\ManagerInterface">
        <plugin name="siteation_debugbar_event"
                type="Siteation\DebugBar\Plugin\Event\ManagerPlugin"
                sortOrder="1"/>
    </type>

    <!-- Every observer that actually ran, timed individually -->
    <type name="Magento\Framework\Event\InvokerInterface">
        <plugin name="siteation_debugbar_observer"
                type="Siteation\DebugBar\Plugin\Event\InvokerPlugin"
                sortOrder="1"/>
    </type>

    <!-- Times every block render, so slow templates surface without a profiler build -->
    <type name="Magento\Framework\View\Element\AbstractBlock">
        <plugin name="siteation_debugbar_block"
                type="Siteation\DebugBar\Plugin\View\BlockPlugin"
                sortOrder="1"/>
    </type>

    <type name="Magento\Framework\App\CacheInterface">
        <plugin name="siteation_debugbar_cache"
                type="Siteation\DebugBar\Plugin\App\CachePlugin"
                sortOrder="1"/>
    </type>

    <type name="Siteation\DebugBar\Model\ProfileManager">
        <arguments>
            <argument name="collectors" xsi:type="array">
                <item name="request" xsi:type="object">Siteation\DebugBar\Collector\RequestCollector</item>
                <item name="queries" xsi:type="object">Siteation\DebugBar\Collector\QueryCollector</item>
                <item name="events" xsi:type="object">Siteation\DebugBar\Collector\EventCollector</item>
                <item name="observers" xsi:type="object">Siteation\DebugBar\Collector\ObserverCollector</item>
                <item name="blocks" xsi:type="object">Siteation\DebugBar\Collector\BlockCollector</item>
                <item name="cache" xsi:type="object">Siteation\DebugBar\Collector\CacheCollector</item>
                <item name="interception" xsi:type="object">Siteation\DebugBar\Collector\InterceptionCollector</item>
            </argument>
        </arguments>
    </type>

    <type name="Siteation\DebugBar\Analysis\ProfileAnalyzer">
        <arguments>
            <argument name="rules" xsi:type="array">
                <item name="request_error" xsi:type="object">Siteation\DebugBar\Analysis\Rule\RequestErrorRule</item>
                <item name="request_slow" xsi:type="object">Siteation\DebugBar\Analysis\Rule\SlowRequestRule</item>
                <item name="query_slow" xsi:type="object">Siteation\DebugBar\Analysis\Rule\SlowQueryRule</item>
                <item name="query_repeated" xsi:type="object">Siteation\DebugBar\Analysis\Rule\RepeatedQueryRule</item>
                <item name="block_slow" xsi:type="object">Siteation\DebugBar\Analysis\Rule\SlowBlockRule</item>
                <item name="observer_slow" xsi:type="object">Siteation\DebugBar\Analysis\Rule\SlowObserverRule</item>
                <item name="cache_miss" xsi:type="object">Siteation\DebugBar\Analysis\Rule\CacheMissRule</item>
                <item name="collector_truncated" xsi:type="object">Siteation\DebugBar\Analysis\Rule\TruncatedCollectorRule</item>
            </argument>
        </arguments>
    </type>

    <type name="Siteation\DebugBar\Mcp\Server">
        <arguments>
            <argument name="tools" xsi:type="array">
                <item name="list_profiles" xsi:type="object">Siteation\DebugBar\Mcp\Tool\ListProfiles</item>
                <item name="get_findings" xsi:type="object">Siteation\DebugBar\Mcp\Tool\GetFindings</item>
                <item name="get_section" xsi:type="object">Siteation\DebugBar\Mcp\Tool\GetSection</item>
                <item name="inspect_queries" xsi:type="object">Siteation\DebugBar\Mcp\Tool\InspectQueries</item>
            </argument>
        </arguments>
    </type>

    <type name="Magento\Framework\Console\CommandListInterface">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="siteation_debugbar_mcp" xsi:type="object">Siteation\DebugBar\Console\McpServerCommand</item>
            </argument>
        </arguments>
    </type>

</config>
