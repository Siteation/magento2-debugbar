<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <!-- Brackets every web request in every area: frontend, adminhtml, GraphQL and REST -->
    <type name="Magento\Framework\App\Http">
        <plugin name="siteation_debugbar_http"
                type="Siteation\DebugBar\Plugin\App\HttpPlugin"
                sortOrder="1"/>
    </type>

    <!-- The PDO adapter brackets every query with these two calls -->
    <type name="Magento\Framework\DB\LoggerInterface">
        <plugin name="siteation_debugbar_query"
                type="Siteation\DebugBar\Plugin\Db\LoggerPlugin"
                sortOrder="1"/>
    </type>

    <type name="Siteation\DebugBar\Model\ProfileManager">
        <arguments>
            <argument name="collectors" xsi:type="array">
                <item name="request" xsi:type="object">Siteation\DebugBar\Collector\RequestCollector</item>
                <item name="queries" xsi:type="object">Siteation\DebugBar\Collector\QueryCollector</item>
            </argument>
        </arguments>
    </type>

</config>
