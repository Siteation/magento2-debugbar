{
  "name": "@siteation/debugbar-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Alpine sources for Siteation_DebugBar. Build output is committed to view/base/web.",
  "scripts": {
    "build": "vite build && vite build --config vite.early.config.js",
    "dev": "vite build --config vite.early.config.js && vite build --watch",
    "test": "node --test 'test/*.test.js'",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "alpinejs": "^3.14.9",
    "highlight.js": "^11.12.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "vite": "^7.1.5"
  }
}
